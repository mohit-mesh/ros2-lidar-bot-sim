# ROS 2 Workspace Folders
# You never want to commit compiled code or logs
build/
install/
log/

# Python Cache
# Prevents Python temporary files from cluttering your repo
__pycache__/
*.py[cod]
*$py.class

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
# Keeps your personal editor settings out of the shared code
.vscode/
.idea/
*.swp
*.swo
*~
